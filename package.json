{
  "name": "@snowy117/pi-dcp",
  "version": "0.1.4",
  "description": "Model-driven, range-only local context compression for the pi coding agent; a slimmed public fork of Snowy's pi-dcp (AGPL-3.0-or-later).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "context",
    "compression"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhbzhy-lost/pi-dcp-migrate.git"
  },
  "homepage": "https://github.com/mhbzhy-lost/pi-dcp-migrate#readme",
  "bugs": {
    "url": "https://github.com/mhbzhy-lost/pi-dcp-migrate/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "*.ts",
    "dcp.schema.json",
    "dist/",
    "scripts/dcp-audit.ts",
    "!test-*.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check:eloc": "tsx test-architecture.ts",
    "typecheck": "tsc --noEmit",
    "test": "for f in test-*.ts; do tsx \"$f\" || exit 1; done",
    "verify": "tsx scripts/verify.ts",
    "build:audit": "node scripts/build-audit.ts",
    "audit:report": "node dist/scripts/dcp-audit.js",
    "verify:observability": "node scripts/verify-observability.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:eloc && npm run build:audit"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "26.4.1",
    "typebox": "1.3.27",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
